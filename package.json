{
  "name": "telos",
  "version": "0.1.3",
  "private": true,
  "description": "A local-first personal intelligence system with replaceable agent runtimes.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run build:packages && pnpm --filter @telos/desktop dev",
    "build": "pnpm run build:packages && pnpm --filter @telos/desktop build",
    "build:packages": "pnpm --filter @telos/personal-core --filter @telos/runtime-contracts --filter @telos/continuity-bench --filter @telos/runtime-dsh build && pnpm --filter @telos/dsh-continuity --filter @telos/dsh-mcp-manager --filter @telos/dsh-multimodal --filter @telos/dsh-personalization --filter @telos/dsh-multi-root-workspace --filter @telos/dsh-workbench-files --filter @telos/dsh-work-report build",
    "typecheck": "pnpm run build:packages && pnpm --filter @telos/desktop typecheck",
    "test": "vitest run --dir packages && vitest run --dir plugins && vitest run --dir apps/desktop && vitest run --dir scripts",
    "lint": "oxlint .",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:desktop:dir": "node scripts/package-desktop.mjs --dir",
    "release:bump": "node scripts/bump-release.mjs",
    "release:prepare-artifacts": "node scripts/prepare-release-artifacts.mjs",
    "dsh:build": "node scripts/build-dsh-runtime.mjs",
    "dsh:audit": "node scripts/audit-dsh-sync.mjs",
    "dsh:parity": "node scripts/audit-dsh-parity.mjs",
    "dsh:smoke": "node scripts/smoke-dsh-runtime.mjs",
    "dsh:continuity:smoke": "node scripts/smoke-dsh-continuity.mjs",
    "dsh:mcp:codegraph:smoke": "pnpm --filter @telos/dsh-mcp-manager build && node scripts/smoke-dsh-mcp-codegraph.mjs",
    "continuity:study-pilo:live": "pnpm --filter @telos/dsh-continuity build && node scripts/evaluate-study-pilo-memory-live.mjs",
    "continuity:bench": "pnpm run build:packages && pnpm dsh:parity && node packages/continuity-bench/dist/cli.js --dsh-parity-pass",
    "dsh:upstream": "node scripts/audit-dsh-sync.mjs --remote",
    "dsh:verify": "pnpm dsh:audit && pnpm dsh:parity"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vitest": "4.1.8",
    "yaml": "2.9.0"
  }
}
